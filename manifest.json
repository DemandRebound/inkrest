{
  "manifest_version": 3,
  "name": "墨息 · Inkrest",
  "version": "1.0.0",
  "description": "极简新标签页：Google / Bing / DuckDuckGo 一键切换、自定义背景、深浅主题与常用站点。",
  "homepage_url": "https://github.com/DemandRebound/inkrest",
  "permissions": ["storage", "topSites", "favicon"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
